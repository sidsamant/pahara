# Copy this file to .env and fill in your PostgreSQL connection details.
# The application reads DATABASE_URL from the environment at runtime.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Local example (PostgreSQL running on your machine):
DATABASE_URL=postgresql://postgres:password@localhost:5432/crawl4ai

# Remote / hosted example:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/crawl4ai
